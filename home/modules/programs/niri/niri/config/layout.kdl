layout {
    gaps 6
    center-focused-column "never"
    always-center-single-column
    empty-workspace-above-first
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    focus-ring {
        on
        width 2
        active-gradient from="#94979C" to="#D3E3FD" angle=45 relative-to="workspace-view"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
    border {
        off
    }
    shadow {
        off
        softness 30
        spread 5
        offset x=0 y=5
        draw-behind-window true
        color "#00000070"
        // inactive-color "#00000054"
    }
    tab-indicator {
        off
    }
    insert-hint {
        // off
        on
        color "#ffc87f80"
        // gradient from="#ffbb6680" to="#ffc88080" angle=45 relative-to="workspace-view"
    }
    struts {}
}
